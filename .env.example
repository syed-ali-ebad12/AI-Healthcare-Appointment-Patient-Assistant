NODE_ENV=development
PORT=4173
DATABASE_URL=postgres://carely:carely@localhost:5432/carely
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
APP_URL=http://localhost:4173

# Optional SMTP notifications. If absent, notifications are logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=Carely <notifications@example.com>

# Optional Twilio SMS notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
